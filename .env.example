# Change this from Settings > Environment, or set it manually before startup.
NODE_ENV=development
# Allowed browser/request hostnames. Use comma-separated exact hostnames.
APP_DOMAIN=localhost,127.0.0.1
# http, https, or both. In both mode HTTP redirects to HTTPS.
APP_PROTOCOL=http
PORT=3010
HOST=127.0.0.1
# Used only with APP_PROTOCOL=both.
HTTP_PORT=3010
HTTPS_PORT=3443
# Required for APP_PROTOCOL=https or both. Paths may be absolute or relative to the project directory.
# HTTPS_CERT_FILE=certs/fullchain.pem
# HTTPS_KEY_FILE=certs/private.key
DATA_DIR=./data
# Production only. Maximum normal API requests per client IP per minute.
# Authentication uses a separate fixed limit of 10 attempts per 15 minutes.
RATE_LIMIT_PER_MINUTE=800
MAX_LOGIN_SESSIONS_PER_USER=0
# Optional. When true, administrator-only OpenAPI docs are available at /api/docs.
SWAGGER_ENABLED=false
# Alert when an enabled schedule has no successful backup within this many hours.
BACKUP_STALE_AFTER_HOURS=26
# Keep this stable across redeploys. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
# Legacy binary-path settings are ignored. VaultBack always uses tools stored inside
# the application directory. Use Settings > Database tools to download or repair them.
# DB_CLIENT_BINARY=
# DB_DUMP_BINARY=
# MYSQL_CLIENT_BINARY=
# MYSQL_DUMP_BINARY=
# MARIADB_CLIENT_BINARY=
# MARIADB_DUMP_BINARY=
# Set to true only when you intentionally allow arbitrary local destination paths.
ALLOW_ANY_LOCAL_PATH=false
# Optional custom HTTPS release manifest used by Settings > Software updates.
# If omitted, VaultBack checks the public GitHub release feed for this project.
# UPDATE_MANIFEST_URL=https://updates.example.com/vaultback/latest.json
# UPDATE_CHANNEL=stable
# UPDATE_PM2_APP=vaultback
